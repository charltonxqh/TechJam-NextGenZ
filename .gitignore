# =========================
# Per-run agent state  (added 2026-08-31)
# =========================
# These change on every run. Committing them means a teammate's pull inherits
# someone else's search tree and memory, their run then overwrites the files,
# and every pull conflicts. Each person's runs should be their own.
# The run log is a required deliverable - snapshot it into deliverables/ when a
# run is one you want to submit, rather than tracking the live file.
src/engine/state/tree.json
src/engine/state/tree.*.json
src/engine/state/memory.json
src/engine/state/state.json
src/engine/state/stages.json
src/engine/state/findings.json
src/engine/state/run_log.jsonl
src/engine/state/best_solution.py
src/engine/state/usage.json
src/engine/state/evaluate.sha256

# One starter kit at the repo root; the tarball is 45M and re-downloadable.
kuairand-starter-kit/KuaiRand-Pure.tar.gz
src/engine/state/findings.*.json

